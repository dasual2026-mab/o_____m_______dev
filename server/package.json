{
  "name": "om-server",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/sync-shared.mjs --check && node --test --test-concurrency=1 \"test/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "embedded-postgres": "17.12.0-beta.19",
    "typescript": "^5.9.0"
  }
}
