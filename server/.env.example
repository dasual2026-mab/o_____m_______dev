# 서버 설정의 이름 목록이다. 값은 여기에 적지 않는다.
# 값은 Supabase 대시보드의 Edge Functions 비밀 값에 넣는다. 넣는 차례는 docs/개발환경.md에 있다.
# 키는 무작위 32바이트를 base64url로 적은 글자다. 대표가 사본을 서버 밖 안전한 곳에 보관한다.

# 환경. dev, test, review, prod 가운데 하나
OM_ENV=dev

# 데이터베이스 접속 주소. 접속 역할마다 따로 둔다. 공유 풀러의 트랜잭션 방식 주소를 쓴다.
OM_DB_URL_APP=
OM_DB_URL_ADMIN=
OM_DB_URL_JOBS=

# 앱 설정 값
OM_MIN_VERSION=1.0.0
OM_MAINTENANCE=
OM_REVIEW_VERSION=
OM_PRODUCT_ID=

# 키 아홉 가지. 기술설계_3 2.4
# 서명 키. 번호를 붙여 둔다. 키를 바꿀 때는 번호를 올려 더하고 CURRENT를 고친다.
OM_KEY_SIGNING_CURRENT=1
OM_KEY_SIGNING_1=
# 가명용 변환 키
OM_KEY_PSEUDONYM=
# 아래 일곱 가지는 그 기능을 만들 때부터 쓴다.
# 연계정보용 변환 키
OM_KEY_CI=
# 번호용 변환 키
OM_KEY_PHONE=
# 미사용자 목록용 변환 키
OM_KEY_NONUSER=
# 개인정보 암호화 키
OM_KEY_PII_CURRENT=1
OM_KEY_PII_1=
# 연결 암호화 키
OM_KEY_LINK_CURRENT=1
OM_KEY_LINK_1=
# 메시지 암호화 키
OM_KEY_MESSAGE_CURRENT=1
OM_KEY_MESSAGE_1=
# 보관용 암호화 키
OM_KEY_ARCHIVE_CURRENT=1
OM_KEY_ARCHIVE_1=
